---
import type { NavNode } from '../lib/research';

interface Props {
  nodes: NavNode[];
  currentSlug: string;
  depth?: number;
}

const { nodes, currentSlug, depth = 0 } = Astro.props;

const isActive = (s: string) => s === currentSlug;
const isAncestor = (s: string) => currentSlug === s || currentSlug.startsWith(s + '/');
---

<ul class:list={['rnav', depth > 0 && 'rnav--nested']}>
  {nodes.map((node) => {
    const active = isActive(node.slug);
    const open = isAncestor(node.slug);
    const hasChildren = node.children.length > 0;
    return (
      <li class="rnav__item">
        <div class="rnav__row">
          {node.hasPage ? (
            <a href={`/research/${node.slug}`} class:list={['rnav__link', active && 'is-active']}>{node.title}</a>
          ) : (
            <span class="rnav__label">{node.title}</span>
          )}
          {hasChildren && (
            <button type="button" class="rnav__toggle" data-nav-toggle aria-expanded={open ? 'true' : 'false'} aria-label={`Toggle ${node.title}`}>
              <svg class:list={['rnav__chevron', open && 'is-open']} viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 2l4 4-4 4" /></svg>
            </button>
          )}
        </div>
        {hasChildren && (
          <div class:list={['rnav__children', open && 'is-open']}>
            <Astro.self nodes={node.children} currentSlug={currentSlug} depth={depth + 1} />
          </div>
        )}
      </li>
    );
  })}
</ul>

<style>
  .rnav { list-style: none; margin: 0; padding: 0; }
  .rnav--nested { margin-left: 0.55rem; border-left: 1px solid rgba(0, 0, 0, 0.1); padding-left: 0.55rem; }
  .rnav__item { margin: 0.05rem 0; }
  .rnav__row { display: flex; align-items: center; gap: 0.2rem; }
  .rnav__link,
  .rnav__label {
    display: block;
    flex: 1;
    min-width: 0;
    padding: 0.28rem 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--color-text);
    border-radius: 4px;
    text-decoration: none;
  }
  .rnav__link:hover { background: color-mix(in srgb, var(--color-accent) 25%, transparent); }
  .rnav__link.is-active { background: var(--color-accent); color: var(--color-accent-text); font-weight: 600; }
  .rnav__label {
    color: var(--color-text-light);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .rnav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-text-light);
    border-radius: 4px;
  }
  .rnav__toggle:hover { background: rgba(0, 0, 0, 0.05); }
  .rnav__chevron { transition: transform 0.15s ease; }
  .rnav__chevron.is-open { transform: rotate(90deg); }
  .rnav__children { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.18s ease; }
  .rnav__children.is-open { grid-template-rows: 1fr; }
  .rnav__children > :global(*) { overflow: hidden; }
</style>
