---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import PasswordGate from '../components/PasswordGate.astro';
import ResearchNavTree from '../components/ResearchNavTree.astro';
import type { NavNode } from '../lib/research';

interface Props {
  title: string;
  nodes: NavNode[];
  currentSlug: string;
}

const { title, nodes, currentSlug } = Astro.props;
---

<BaseLayout title={`${title} | Research`} description="Private research artifacts." noindex>
  <Header variant="page" />
  <div class="page-top-border" aria-hidden="true"></div>

  <PasswordGate
    title="Research"
    description="Private research artifacts. Enter the password to continue."
    storageKey="research-auth"
  >
    <div class="research">
      <aside class="research__sidebar">
        <a href="/research" class="research__home">Research</a>
        <nav class="research__nav" aria-label="Research sections">
          <ResearchNavTree nodes={nodes} currentSlug={currentSlug} />
        </nav>
      </aside>
      <main class="research__main">
        <article class="research__doc prose">
          <slot />
        </article>
      </main>
    </div>
  </PasswordGate>

  <!-- Floating footnote/reference preview (populated on scroll after the gate reveals content) -->
  <div class="fn-preview" id="fn-preview" aria-live="polite">
    <button class="fn-preview__close" id="fn-preview-close" aria-label="Dismiss">&times;</button>
    <div class="fn-preview__items" id="fn-preview-items"></div>
  </div>
</BaseLayout>

<script>
  // Delegated, idempotent collapse toggling. Bound once on `document`, which survives
  // View Transitions, and works on markup injected by the password gate (delegation).
  if (!(window as any).__researchNavBound) {
    (window as any).__researchNavBound = true;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-nav-toggle]');
      if (!btn) return;
      const item = btn.closest('.rnav__item');
      const children = item?.querySelector(':scope > .rnav__children') as HTMLElement | null;
      if (!children) return;
      const open = children.classList.toggle('is-open');
      btn.querySelector('.rnav__chevron')?.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>

<script>
  // Floating footnote (Sources) preview — the commons reference mechanism, adapted for
  // the password gate: content is injected via innerHTML after auth, so we (re)initialize
  // on the `pw:revealed` signal as well as normal loads. Idempotent — the prior observer is
  // disconnected before rebinding, and state is reset each time.
  let fnObserver: IntersectionObserver | null = null;
  const fnVisible = new Set<string>();
  let fnDismissed = false;
  let fnHideTimer: number | undefined;
  let fnCloseBound = false;

  function fnMaxItems() {
    return window.innerWidth >= 861 ? 3 : 2;
  }

  function renderFnPreview(refMap: Map<string, string>) {
    const preview = document.getElementById('fn-preview');
    const itemsEl = document.getElementById('fn-preview-items');
    if (!preview || !itemsEl || fnDismissed) return;
    if (fnHideTimer) { clearTimeout(fnHideTimer); fnHideTimer = undefined; }
    if (!fnVisible.size) {
      fnHideTimer = window.setTimeout(() => preview.classList.remove('is-visible'), 300);
      return;
    }
    const nums = Array.from(fnVisible).sort((a, b) => Number(a) - Number(b)).slice(0, fnMaxItems());
    itemsEl.innerHTML = '';
    for (const n of nums) {
      const text = refMap.get(n);
      if (!text) continue;
      const item = document.createElement('div');
      item.className = 'fn-preview__item';
      const num = document.createElement('span');
      num.className = 'fn-preview__num';
      num.textContent = n;
      const txt = document.createElement('span');
      txt.className = 'fn-preview__text';
      txt.textContent = text;
      item.append(num, txt);
      itemsEl.appendChild(item);
    }
    preview.classList.add('is-visible');
  }

  function initFootnotePreview() {
    const preview = document.getElementById('fn-preview');
    const itemsEl = document.getElementById('fn-preview-items');
    const closeBtn = document.getElementById('fn-preview-close');
    if (!preview || !itemsEl) return;

    fnObserver?.disconnect();
    fnVisible.clear();
    fnDismissed = false;
    preview.classList.remove('is-visible');

    const refs = Array.from(document.querySelectorAll('a[data-footnote-ref]')) as HTMLElement[];
    if (!refs.length) return;

    const refMap = new Map<string, string>();
    document.querySelectorAll('section[data-footnotes] ol > li').forEach((li) => {
      const num = (li as HTMLElement).id.replace(/^user-content-fn-/, '');
      const clone = li.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('a[data-footnote-backref]').forEach((el) => el.remove());
      refMap.set(num, (clone.textContent || '').trim());
    });

    if (closeBtn && !fnCloseBound) {
      fnCloseBound = true;
      closeBtn.addEventListener('click', () => {
        document.getElementById('fn-preview')?.classList.remove('is-visible');
        fnDismissed = true;
        fnVisible.clear();
      });
    }

    fnObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const ref = entry.target.querySelector('a[data-footnote-ref]') as HTMLElement | null
          ?? (entry.target as HTMLElement);
        const num = ref.getAttribute('href')?.replace(/^#user-content-fn-/, '') || '';
        if (!num) continue;
        if (entry.isIntersecting) fnVisible.add(num);
        else fnVisible.delete(num);
      }
      renderFnPreview(refMap);
    }, { threshold: 1 });

    refs.forEach((ref) => fnObserver!.observe(ref.closest('sup') || ref));
  }

  document.addEventListener('astro:page-load', initFootnotePreview);
  document.addEventListener('pw:revealed', initFootnotePreview);
</script>

<style>
  .page-top-border {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 10px;
    background-color: var(--color-accent);
    z-index: 400;
    pointer-events: none;
  }

  .research {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--spacing-md);
    max-width: var(--page-max-width);
    margin: 0 auto;
    padding: 5rem var(--spacing-md) var(--spacing-xl);
    align-items: start;
  }

  .research__sidebar {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
  }

  .research__home {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .research__main { min-width: 0; }

  @media (max-width: 860px) {
    .research {
      grid-template-columns: 1fr;
      padding-top: 4.5rem;
    }
    .research__sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      padding-bottom: 1rem;
      margin-bottom: 1rem;
    }
  }
</style>
